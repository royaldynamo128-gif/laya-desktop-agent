#!/usr/bin/env python3
"""
Fake xdg-open — records URL/file open requests to $BROWSER_LOG (JSONL).
Simulates a browser: registers a browser window in the fake WM state whose
title embeds the URL, so downstream title-based verification works.
"""
import json
import os
import sys
import time
import uuid


def main() -> int:
    target = sys.argv[1] if len(sys.argv) > 1 else ""
    log = os.environ.get("BROWSER_LOG", "")

    entry = {"url": target, "ts": time.time()}
    if log:
        with open(log, "a") as f:
            f.write(json.dumps(entry) + "\n")

    # Register a simulated browser window in the fake window manager
    state_path = os.environ.get("KDOTOOL_STATE", "")
    if state_path and os.path.exists(state_path):
        try:
            with open(state_path, "r") as f:
                state = json.load(f)
            delay_ms = int(os.environ.get("FAKEBROWSER_OPEN_DELAY_MS", "150"))
            time.sleep(delay_ms / 1000.0)
            wid = "{" + str(uuid.uuid4()) + "}"
            # A browser-like title: "Page Title — Mozilla Firefox" style
            pretty = target.replace("https://", "").replace("http://", "")[:60]
            state.setdefault("windows", {})[wid] = {
                "name": f"{pretty} - Browser",
                "class": "browser",
                "desktop": state.get("desktop", 1),
                "states": [],
                "pid": os.getpid(),
                "url": target,
            }
            state["active"] = wid
            tmp = state_path + ".tmp"
            with open(tmp, "w") as f:
                json.dump(state, f)
            os.replace(tmp, state_path)
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
